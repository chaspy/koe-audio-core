#!/usr/bin/env bash
# configure -> build -> ctest -> ASan/UBSan tests -> optional libFuzzer -> optional kagami check
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== configure + build"
cmake -S . -B build/default >/dev/null
cmake --build build/default -j 2

echo "== ctest"
ctest --test-dir build/default -j 2 --output-on-failure

echo "== configure + build (ASan/UBSan)"
cmake -S . -B build/asan -DKOE_SANITIZE=ON >/dev/null
cmake --build build/asan -j 2

echo "== ctest (ASan/UBSan)"
ctest --test-dir build/asan -j 2 --output-on-failure

if command -v x86_64-w64-mingw32-g++ >/dev/null 2>&1; then
  echo "== Windows cross-build (MinGW)"
  cmake -S . -B build/mingw -DCMAKE_TOOLCHAIN_FILE=cmake/mingw-w64.cmake \
    -DKOE_BUILD_TESTS=ON -DKOE_SANITIZE=OFF >/dev/null
  # Compile and link the C17 ABI test for Windows; do not execute it on the host.
  cmake --build build/mingw --target koe_audio test_c_api -j 2
  symbols=$(x86_64-w64-mingw32-nm --defined-only --extern-only build/mingw/libkoe_audio.a)
  for symbol in koe_audio_api_version koe_measure_i16 koe_measure_f32 koe_too_quiet; do
    if ! awk -v symbol="$symbol" '$2 == "T" && $3 == symbol { found = 1 } END { exit !found }' <<<"$symbols"; then
      echo "Missing unmangled C symbol: $symbol" >&2
      exit 1
    fi
    echo "Verified C symbol: $symbol"
  done
else
  echo "MinGW not found; skipping the Windows cross-build"
fi

llvm_bin=/opt/homebrew/opt/llvm/bin
if [[ -x "$llvm_bin/clang++" ]]; then
  echo "== libFuzzer (30 s)"
  cmake -S . -B build/fuzz -DCMAKE_CXX_COMPILER="$llvm_bin/clang++" \
    -DCMAKE_C_COMPILER="$llvm_bin/clang" >/dev/null
  cmake --build build/fuzz --target fuzz_measure -j 2
  mkdir -p build/fuzz/ci-corpus build/fuzz/artifacts
  # Single process; new inputs go to build/, the checked-in seeds stay read-only.
  build/fuzz/fuzz_measure -max_total_time=30 -rss_limit_mb=2048 -max_len=65536 \
    -artifact_prefix=build/fuzz/artifacts/ build/fuzz/ci-corpus fuzz/corpus
else
  echo "Homebrew LLVM not found; skipping libFuzzer"
fi

if command -v kagami >/dev/null 2>&1; then
  echo "== kagami check"
  kagami check --format agent-brief
else
  echo "kagami not found; skipping the optional quality gate"
fi

echo "== ci: ok"
